# Copie para .env e preencha. O .env serve aos dois modos: `docker compose` e `uv run`.
# Este arquivo NÃO traz segredos que funcionem: sem preencher os campos obrigatórios
# (AUDITORIA_CHAVE_HMAC e CUSTODIA_CHAVE; no Docker, também as senhas do PostgreSQL), o serviço
# não inicia (ele falha fechado).
# Servidor local: uv run uvicorn buscador.main:app --port 8100 --reload (no Docker: 127.0.0.1:8100).

# ---- Obrigatórias -------------------------------------------------------------------------

# Chave do HMAC que autentica a cadeia de auditoria (mínimo de 32 caracteres).
# Gere com `openssl rand -hex 32`. Fica só no ambiente, nunca no banco. Se for trocada ou
# perdida, as entradas já gravadas deixam de conferir: guarde uma cópia em local seguro.
AUDITORIA_CHAVE_HMAC=

# Chave mestra da criptografia em repouso (RNF01, H23): 32 bytes em hexadecimal, gere com
# `openssl rand -hex 32`. Cifra as capturas no disco (AES-256-GCM) e os segredos de TOTP no
# banco. Fica só no ambiente OU num arquivo (CUSTODIA_CHAVE_ARQUIVO), nunca no banco. Se for
# perdida, as capturas cifradas não podem mais ser lidas: guarde uma cópia em local seguro.
CUSTODIA_CHAVE=
# Alternativa: caminho de um arquivo com a chave em hexadecimal (defina só uma das duas).
CUSTODIA_CHAVE_ARQUIVO=
# Chaves anteriores (hexadecimal, separadas por vírgula), só para LER o que foi cifrado antes de
# uma troca de chave. O que for gravado depois usa CUSTODIA_CHAVE.
CUSTODIA_CHAVES_ANTERIORES=

# Só para o Docker Compose: senha do papel dono do banco (usada pelo PostgreSQL e pelo serviço
# "migracao") e senha do papel da aplicação (usada pela API). Use valores hexadecimais
# diferentes entre si, por exemplo `openssl rand -hex 24`.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# ---- Opcionais ----------------------------------------------------------------------------

# Modo de desenvolvimento local: aceita os tokens fixos de TOKENS_DEV (sem senha e sem MFA) e
# liga /docs, /redoc e /openapi.json (que não exigem token). Nunca use fora da sua máquina.
MODO_DEV=0
# Tokens fixos de desenvolvimento, no formato token:usuario:perfil, separados por vírgula
# (perfis: analista, delegado, admin). SÓ são aceitos com MODO_DEV=1; com MODO_DEV=0 esta
# variável precisa ficar vazia, senão o serviço não inicia. O acesso normal é por usuário real:
#   python -m buscador.usuarios criar <usuario> <perfil>     (senha + MFA por TOTP no 1º login)
TOKENS_DEV=

# Usuários, MFA e sessão (RNF01, H23).
# Perfis para os quais o segundo fator (TOTP, RFC 6238) é obrigatório.
MFA_PERFIS_OBRIGATORIOS=analista,delegado,admin
# Nome mostrado no aplicativo autenticador.
TOTP_EMISSOR=Buscador OSINT
SENHA_TAMANHO_MINIMO=12
# Sessão: duração máxima, tempo máximo sem uso e validade da etapa entre a senha e o código.
SESSAO_DURACAO_MINUTOS=480
SESSAO_INATIVIDADE_MINUTOS=30
SESSAO_PENDENTE_MINUTOS=5
# Falhas seguidas (senha ou código) até bloquear a conta, e por quanto tempo.
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Grafo (RNF06, H29): tetos das consultas de vínculo feitas no banco (docs/desempenho-grafo.md).
GRAFO_MAX_NOS=20000
GRAFO_MAX_NOS_VISITADOS=200000

# Extração assistida por IA (RF13, H22). DESLIGADA por padrão. Só servidor LOCAL (loopback, rede
# privada ou um nome listado em IA_HOSTS_LOCAIS): nenhum dado de investigação sai do servidor.
IA_EXTRACAO_ATIVA=0
# ollama | falso (o provedor falso é só para testes e demonstração e exige MODO_DEV=1)
IA_PROVEDOR=ollama
IA_OLLAMA_URL=http://127.0.0.1:11434
# Nome do modelo instalado no servidor local (obrigatório com IA_EXTRACAO_ATIVA=1).
IA_MODELO=
IA_HOSTS_LOCAIS=
IA_TIMEOUT_SEGUNDOS=120
IA_MAX_CARACTERES=200000
IA_TAMANHO_BLOCO=6000
IA_MAX_ITENS=300
IA_TEMPERATURA=0
IA_SEMENTE=0

# Banco de dados. SQLite em desenvolvimento; no Docker Compose a API usa PostgreSQL com o papel
# da aplicação (a URL é montada no docker-compose.yml).
DATABASE_URL=sqlite:///./dados/buscador.db
# 1: a API cria tabelas e gatilhos ao iniciar (SQLite local). 0: o esquema já foi criado pelo
# papel dono com `python -m buscador.migrar` (é o que o Compose faz).
DB_CRIAR_ESQUEMA=1

# Pasta das capturas brutas (<DADOS_DIR>/capturas/<aa>/<sha256>) e da âncora externa da
# auditoria (<DADOS_DIR>/ancora/auditoria.json).
DADOS_DIR=./dados

# Origens permitidas no CORS (front-end Vite em 5190 e nginx do front-end em 8090).
CORS_ORIGENS=http://localhost:5190,http://localhost:8090

# Tamanho máximo do corpo de uma requisição, em bytes (acima disso: 413).
MAX_CORPO_BYTES=262144

# Raiz de ingestão do conector cnpj_arquivo. O parâmetro "diretorio" da coleta é relativo a esta
# pasta e não pode sair dela. Vazia: a fonte cnpj_arquivo fica desativada.
# Com as fixtures sintéticas do repositório: CNPJ_DIR_BASE=./tests/fixtures e diretorio "cnpj".
CNPJ_DIR_BASE=
CNPJ_MAX_BYTES_ARQUIVO=16777216
CNPJ_MAX_REGISTROS=100000

# API de consulta do PNCP (sem autenticação) e limites de cada coleta.
PNCP_URL_BASE=https://pncp.gov.br/api/consulta
PNCP_TIMEOUT_SEGUNDOS=30
PNCP_TENTATIVAS=3
PNCP_MAX_PAGINAS=20
PNCP_MAX_DIAS_PERIODO=366
PNCP_MAX_BYTES_PAGINA=8388608
PNCP_PRAZO_TOTAL_SEGUNDOS=120

# API de integração do PNCP, usada só para consultar termos de contrato (aditivos), contrato a
# contrato. O PNCP não documenta limite de requisições: o valor abaixo é decisão do autor (0 desliga).
PNCP_INTEGRACAO_URL_BASE=https://pncp.gov.br/api/pncp
PNCP_TERMOS_REQUISICOES_POR_MINUTO=60
PNCP_TERMOS_MAX_CONTRATOS=100

# Portal da Transparência (CEIS, CNEP e servidores). A chave é obtida em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email e vai no cabeçalho
# chave-api-dados. Vazia: a fonte fica "não configurada" (a coleta não falha; só não consulta).
PORTAL_TRANSPARENCIA_CHAVE=
PORTAL_TRANSPARENCIA_URL_BASE=https://api.portaldatransparencia.gov.br
PORTAL_TRANSPARENCIA_TIMEOUT_SEGUNDOS=30
# Controle de taxa (RNF12). Limite documentado: 400 requisições por minuto das 6:00 às 23:59 e
# 700 das 00:00 às 5:59 (https://portaldatransparencia.gov.br/api-de-dados). Teto aceito: 700.
PORTAL_TRANSPARENCIA_REQUISICOES_POR_MINUTO=300
PORTAL_TRANSPARENCIA_MAX_PAGINAS=200

# Raízes de ingestão dos conectores tse_arquivo e edital_arquivo (como CNPJ_DIR_BASE). Vazias: a
# fonte fica desativada. Piloto com dados públicos reais: use a pasta ./dados-reais (fora do git)
# e, no Docker, o arquivo docker-compose.dados-reais.yml. Com as fixtures sintéticas: TSE_DIR_BASE=./tests/fixtures/h2 e
# diretorio "tse"; EDITAIS_DIR_BASE=./tests/fixtures/h2 e diretorio "editais".
TSE_DIR_BASE=
TSE_MAX_BYTES_ARQUIVO=67108864
TSE_MAX_REGISTROS=200000
# Maior CSV/ZIP do TSE lido EM FLUXO (só o recorte filtrado por uf, municipio ou candidatos é
# guardado; o recorte continua limitado por TSE_MAX_BYTES_ARQUIVO). Padrão: 2 GiB.
TSE_MAX_BYTES_FLUXO=2147483648
EDITAIS_DIR_BASE=
EDITAIS_MAX_BYTES_ARQUIVO=4194304
EDITAIS_MAX_ARQUIVOS=50
# Editais em PDF (com camada de texto; OCR fora do escopo). Limites defensivos: tamanho do arquivo
# (50 MiB; um edital real do PNCP conferido em 17/11/2026 tinha 19 MB), número de páginas, total
# de caracteres extraídos e prazo da extração (roda num processo separado, morto no prazo).
# PDF criptografado ou corrompido é recusado; escaneado fica na custódia "sem camada de texto".
EDITAIS_PDF_MAX_BYTES=52428800
EDITAIS_PDF_MAX_PAGINAS=300
EDITAIS_PDF_MAX_CARACTERES=5000000
EDITAIS_PDF_TEMPO_SEGUNDOS=60

# Retentativa dos conectores sem ajuste próprio (RNF12): cnpj_arquivo, tse_arquivo, edital_arquivo
# e Portal da Transparência.
# O PNCP usa PNCP_TENTATIVAS. A espera cresce a cada tentativa (espera x número da tentativa).
COLETA_TENTATIVAS=3
COLETA_ESPERA_RETENTATIVA_SEGUNDOS=1

# Maior grupo (mesmo endereço ou mesmo nome) expandido par a par na resolução de entidades.
RESOLUCAO_MAX_GRUPO=50

# Limiares das tipologias (RF04). Podem ser sobrescritos por requisição em POST /casos/{id}/alertas/executar.
T1_DIAS_MINIMOS=180
T2_MINIMO_EMPRESAS=3
T3_RAZAO_MINIMA=10

# Tipologias do horizonte 2 (T5 a T10); fontes legais em buscador/tipologias/legislacao.py.
# T5: limites de dispensa de outros exercícios, em JSON (2026 já está no código, do Decreto
# 12.807/2025). Exemplo: {"2027":{"inciso_i":135000.00,"inciso_ii":67500.00,"fonte":"ato do MGI"}}
T5_LIMITES_DISPENSA=
T5_MINIMO_CONTRATACOES=2
# fornecedor_e_categoria | categoria | fornecedor
T5_CRITERIO_NATUREZA=fornecedor_e_categoria
# T8: percentuais do art. 125 da Lei 14.133/2021.
T8_PERCENTUAL_LIMITE=25
T8_PERCENTUAL_LIMITE_REFORMA=50
# T9: situações de totalização do TSE que contam como "eleito" (pendente de conferência no leiame).
T9_SITUACOES_ELEITO=ELEITO,ELEITO POR QP,ELEITO POR MÉDIA
# T10: expressões regulares extras, separadas por ";;".
T10_EXPRESSOES_EXTRAS=

# Tipologias de lavagem e ocultação (L); critérios e fontes em buscador/tipologias/lavagem.py.
# Todos os limiares são decisão do autor, a validar com o orientador.
# L1: empresas ativas no mesmo endereço (com complemento) e concentração das aberturas.
L1_MINIMO_ESTABELECIMENTOS=5
L1_JANELA_ABERTURA_DIAS=180
L1_MINIMO_ABERTAS_NA_JANELA=3
# L3: mesma pessoa provável na administração de N empresas, J delas abertas em M meses.
L3_MINIMO_EMPRESAS=5
L3_MINIMO_ABERTAS_NA_JANELA=3
L3_JANELA_MESES=12
# L4: níveis de sócio pessoa jurídica sem pessoa física no primeiro nível.
L4_MINIMO_NIVEIS=2
# L7: tolerância (dias) depois da abertura e janela (meses) antes do contrato.
L7_DIAS_APOS_ABERTURA=30
L7_MESES_ANTES_CONTRATO=12
# L14 (sinal fraco): valor contratado mínimo e faixas etárias atípicas (códigos do layout).
L14_VALOR_MINIMO=100000
L14_FAIXAS_ATIPICAS=1,2,9
# L15 (sinal fraco): número de CNAEs e de categorias de objeto.
L15_MINIMO_CNAES=20
L15_MINIMO_CATEGORIAS=4
# Qualificações de sócio que contam como administração (L3, L10 e L14).
QUALIFICACOES_ADMINISTRACAO=05,10,16,28,49,50,65
# L6: limites do MEI de outros anos, em JSON (2026, 2027 e 2028 já estão no código, da LC
# 123/2006 e da LC 238/2026). Exemplo: {"2029":{"anual":150000,"mensal_inicio":12500,"fonte":"lei"}}
L6_LIMITES_MEI=
# L6: compara com o maior entre o limite do ano e o do ano seguinte (transição de limite).
L6_TOLERANCIA_TRANSICAO=1
# L16: dias entre a abertura e a vigência do convênio, e naturezas jurídicas sem fins lucrativos.
L16_DIAS_MINIMOS=180
L16_NATUREZAS_SEM_FINS_LUCRATIVOS=3069,3301,3999

# Monitoramento contínuo (RF06, H18): agendador interno, sem serviço externo. Com mais de um
# processo da API, ligue-o em um só.
MONITORAMENTO_AGENDADOR_ATIVO=1
MONITORAMENTO_INTERVALO_SEGUNDOS=60
MONITORAMENTO_PERIODICIDADE_MINIMA_HORAS=1
